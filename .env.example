PORT=3000
# Set to the exact public origin behind a production HTTPS reverse proxy.
# PUBLIC_ORIGIN=https://nyambung.example.com
DATABASE_PATH=data/nyambung.sqlite
# Only read by the offline content CLI, never required by gameplay.
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
# Set once before preparing content. Keep these dates fixed in production.
CONTENT_START_DATE=2026-10-22

# Discord beta: leave disabled for browser-only deployments.
# Never prefix secrets with VITE_. The client gets only application ID via bootstrap.
DISCORD_ENABLED=false
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_BETA_GUILD_ID=
DISCORD_GUILD_IDS=

# Multiplayer: enable after testing WebSocket forwarding and the writable data volume.
MABAR_ENABLED=false
# Optional; defaults to the uploads directory next to DATABASE_PATH.
# UPLOAD_DIR=data/uploads
